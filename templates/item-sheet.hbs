<div class="solo10-sheet-container solo10-item-sheet solo10-theme-light">
  <header class="solo10-sheet-header">
    <img class="solo10-item-img" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" title="Alterar ícone do item" />
    <div class="solo10-title-row" style="width:100%;">
      <input type="text" class="solo10-charname" name="name" value="{{item.name}}" placeholder="Nome do Item" />
      <span class="solo10-badge">{{typeLabel}}</span>
      <button type="button" class="solo10-btn solo10-btn-sm" data-action="postToChat">
        <i class="fas fa-comment"></i> Chat
      </button>
    </div>
  </header>

  <section class="solo10-item-body">
    {{#if (eq item.type 'pericia')}}
      <div class="solo10-panel">
        <p class="solo10-hint">
          Esta Perícia concede <strong>+2</strong> na rolagem. Ela é independente de Atributo — o Atributo (Corpo, Espírito ou Mente) é escolhido livremente na hora do teste.
        </p>
        <div class="solo10-form-group">
          <label>Identificador (Opcional)</label>
          <input type="text" name="system.slug" value="{{system.slug}}" placeholder="Ex: investigacao" />
        </div>
      </div>
    {{/if}}

    {{#if (eq item.type 'qualidade')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Tipo de Qualidade</label>
            <select name="system.tipo">
              <option value="passiva" {{#if (eq system.tipo 'passiva')}}selected{{/if}}>Passiva (Bônus Automático)</option>
              <option value="ativa" {{#if (eq system.tipo 'ativa')}}selected{{/if}}>Ativa (Requer Rolagem)</option>
            </select>
          </div>
          <div class="solo10-form-group">
            <label>Identificador (Opcional)</label>
            <input type="text" name="system.slug" value="{{system.slug}}" placeholder="Ex: vigoroso" />
          </div>
        </div>

        <h4 class="solo10-subhead">Modificadores Modulares (Opcional)</h4>
        <div class="solo10-grid-3">
          <div class="solo10-form-group">
            <label>+ Saúde Máx.</label>
            <input type="number" name="system.bonusSaude" value="{{system.bonusSaude}}" />
          </div>
          <div class="solo10-form-group">
            <label>+ Postura Máx.</label>
            <input type="number" name="system.bonusPostura" value="{{system.bonusPostura}}" />
          </div>
          <div class="solo10-form-group">
            <label>+ Vontade Máx.</label>
            <input type="number" name="system.bonusVontade" value="{{system.bonusVontade}}" />
          </div>
        </div>

        <div class="solo10-grid-2" style="margin-top: 6px;">
          <div class="solo10-form-group">
            <label>+ Resistência a Dano (RD)</label>
            <input type="number" name="system.bonusRD" value="{{system.bonusRD}}" />
          </div>
          <div class="solo10-form-group">
            <label>+ Bônus em Teste</label>
            <input type="number" name="system.bonusTeste" value="{{system.bonusTeste}}" />
          </div>
        </div>

        <label class="solo10-checkbox" style="margin-top: 6px;">
          <input type="checkbox" name="system.concedeVantagem" {{#if system.concedeVantagem}}checked{{/if}} />
          <span>Concede Vantagem (2D10) nos testes aplicáveis</span>
        </label>
      </div>
    {{/if}}

    {{#if (eq item.type 'arma')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Alcance</label>
            <select name="system.alcance">
              <option value="corporal" {{#if (eq system.alcance 'corporal')}}selected{{/if}}>Combate Corporal</option>
              <option value="distancia" {{#if (eq system.alcance 'distancia')}}selected{{/if}}>Combate a Distância</option>
            </select>
          </div>
          <div class="solo10-form-group">
            <label>Tipo de Dano</label>
            <select name="system.tipoDano">
              <option value="corpo" {{#if (eq system.tipoDano 'corpo')}}selected{{/if}}>Atributo Corpo + Bônus</option>
              <option value="fixo" {{#if (eq system.tipoDano 'fixo')}}selected{{/if}}>Dano Fixo (Granadas / Explosivos)</option>
            </select>
          </div>
        </div>
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Bônus de Dano (+1, +2, +3)</label>
            <input type="number" name="system.bonusDano" value="{{system.bonusDano}}" />
          </div>
          <div class="solo10-form-group">
            <label>Dano Fixo (se aplicável)</label>
            <input type="number" name="system.danoFixo" value="{{system.danoFixo}}" />
          </div>
        </div>
        <div class="solo10-form-group" style="margin-top:6px;">
          <label class="solo10-checkbox"><input type="checkbox" name="system.leve" {{#if system.leve}}checked{{/if}} /> <span>Arma Leve</span></label>
          <label class="solo10-checkbox"><input type="checkbox" name="system.pesada" {{#if system.pesada}}checked{{/if}} /> <span>Arma Pesada</span></label>
          <label class="solo10-checkbox"><input type="checkbox" name="system.duasMaos" {{#if system.duasMaos}}checked{{/if}} /> <span>Arma de Duas Mãos</span></label>
        </div>
      </div>
    {{/if}}

    {{#if (eq item.type 'armadura')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Resistência a Dano (RD)</label>
            <input type="number" name="system.resistenciaDano" value="{{system.resistenciaDano}}" min="0" />
          </div>
          <div class="solo10-form-group">
            <label>Custo ($)</label>
            <input type="number" name="system.custo" value="{{system.custo}}" min="0" />
          </div>
        </div>
        <div class="solo10-form-group" style="margin-top:6px;">
          <label class="solo10-checkbox"><input type="checkbox" name="system.equipada" {{#if system.equipada}}checked{{/if}} /> <span>Equipada</span></label>
          <label class="solo10-checkbox"><input type="checkbox" name="system.penalidadeAgilidade" {{#if system.penalidadeAgilidade}}checked{{/if}} /> <span>*Desvantagem em destreza/agilidade</span></label>
          <label class="solo10-checkbox"><input type="checkbox" name="system.leve" {{#if system.leve}}checked{{/if}} /> <span>Armadura Leve</span></label>
          <label class="solo10-checkbox"><input type="checkbox" name="system.escudo" {{#if system.escudo}}checked{{/if}} /> <span>Escudo</span></label>
        </div>
      </div>
    {{/if}}

    {{#if (eq item.type 'equipamento')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Quantidade</label>
            <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" />
          </div>
          <div class="solo10-form-group">
            <label>Custo de Mercado ($)</label>
            <input type="number" name="system.custo" value="{{system.custo}}" min="0" />
          </div>
        </div>
      </div>
    {{/if}}

    {{#if (eq item.type 'armadilha')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Efeito Principal</label>
            <select name="system.efeito">
              {{#each efeitosArmadilha}}
                <option value="{{@key}}" {{#if (eq ../system.efeito @key)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="solo10-form-group">
            <label>Bônus de Poder Obtido</label>
            <input type="number" name="system.bonusPoder" value="{{system.bonusPoder}}" min="0" />
          </div>
        </div>
      </div>
    {{/if}}

    {{#if (eq item.type 'magia')}}
      <div class="solo10-panel">
        <div class="solo10-grid-2">
          <div class="solo10-form-group">
            <label>Escola / Círculo / Tradição</label>
            <input type="text" name="system.escola" value="{{system.escola}}" placeholder="Ex: 1º Círculo, Elemental, Ritual..." />
          </div>
          <div class="solo10-form-group">
            <label>Atributo Base de Conjuração</label>
            <select name="system.atributo">
              <option value="mente" {{#if (eq system.atributo 'mente')}}selected{{/if}}>Mente</option>
              <option value="espirito" {{#if (eq system.atributo 'espirito')}}selected{{/if}}>Espírito</option>
              <option value="corpo" {{#if (eq system.atributo 'corpo')}}selected{{/if}}>Corpo</option>
            </select>
          </div>
        </div>
        <div class="solo10-grid-3" style="margin-top: 8px;">
          <div class="solo10-form-group">
            <label>Custo</label>
            <input type="text" name="system.custo" value="{{system.custo}}" placeholder="Ex: 1 Vontade" />
          </div>
          <div class="solo10-form-group">
            <label>Alcance</label>
            <input type="text" name="system.alcance" value="{{system.alcance}}" placeholder="Ex: 1 Setor" />
          </div>
          <div class="solo10-form-group">
            <label>Duração</label>
            <input type="text" name="system.duracao" value="{{system.duracao}}" placeholder="Ex: Instantânea" />
          </div>
        </div>
        <div class="solo10-form-group" style="margin-top: 8px;">
          <label>Bônus no Teste de Conjuração</label>
          <input type="number" name="system.bonusTeste" value="{{system.bonusTeste}}" />
        </div>
      </div>
    {{/if}}

    <div class="solo10-panel">
      <div class="solo10-form-group">
        <label>Descrição</label>
        <textarea name="system.descricao" rows="5">{{system.descricao}}</textarea>
      </div>
    </div>
  </section>
</div>
