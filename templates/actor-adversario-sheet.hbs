<div class="solo10-sheet-container solo10-adversario-sheet">
  <header class="solo10-sheet-header">
    <div class="solo10-header-left">
      <img class="solo10-profile-img" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img" />
    </div>
    <div class="solo10-header-main">
      <div class="solo10-title-row">
        <input type="text" class="solo10-charname" name="name" value="{{actor.name}}" placeholder="Nome do Adversário" />
        <div class="solo10-perigo-box">
          <label>Perigo (Máx 15)</label>
          <input type="number" name="system.perigo" value="{{system.perigo}}" min="0" max="15" />
        </div>
      </div>

      <!-- TABELA OFICIAL DE ADVERSÁRIO DO LIVRO -->
      <div class="solo10-reservas-bar">
        <div class="solo10-reserva-box {{#if system.derrotadoSaude}}alerta-zero{{/if}}">
          <div class="reserva-title"><span>Saúde</span></div>
          <div class="reserva-inputs">
            <input type="number" name="system.saude.value" value="{{system.saude.value}}" min="0" />
            <span class="sep">/</span>
            <input type="number" name="system.saude.max" value="{{system.saude.max}}" min="0" />
          </div>
        </div>

        <div class="solo10-reserva-box {{#if system.derrotadoPostura}}alerta-zero{{/if}}">
          <div class="reserva-title"><span>Postura</span></div>
          <div class="reserva-inputs">
            <input type="number" name="system.postura.value" value="{{system.postura.value}}" min="0" />
            <span class="sep">/</span>
            <input type="number" name="system.postura.max" value="{{system.postura.max}}" min="0" />
          </div>
        </div>

        <div class="solo10-reserva-box {{#if system.derrotadoVontade}}alerta-zero{{/if}}">
          <div class="reserva-title"><span>Vontade</span></div>
          <div class="reserva-inputs">
            <input type="number" name="system.vontade.value" value="{{system.vontade.value}}" min="0" />
            <span class="sep">/</span>
            <input type="number" name="system.vontade.max" value="{{system.vontade.max}}" min="0" />
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="solo10-sheet-body">
    <div class="solo10-panel">
      <div class="solo10-panel-header">
        <h3>Ataque (Reação) & Características</h3>
        <button type="button" class="solo10-btn solo10-btn-danger" data-action="dispararReacao">
          <i class="fas fa-bolt"></i> Disparar Ataque (Reação) no Chat
        </button>
      </div>

      <div class="solo10-form-group">
        <label>Dano da Reação (X de dano à Saúde quando o alvo falha no teste)</label>
        <input type="number" name="system.danoReacao" value="{{system.danoReacao}}" min="0" />
      </div>

      <div class="solo10-form-group">
        <label>Ataque (Reação)</label>
        <textarea name="system.ataqueReacao" rows="3">{{system.ataqueReacao}}</textarea>
      </div>

      <div class="solo10-form-group">
        <label>Outras Características (Habilidades Passivas / Reações Extras)</label>
        <textarea name="system.outrasCaracteristicas" rows="3">{{system.outrasCaracteristicas}}</textarea>
      </div>

      <div class="solo10-form-group">
        <label>Descrição do Adversário</label>
        <textarea name="system.descricao" rows="4">{{system.descricao}}</textarea>
      </div>
    </div>
  </section>
</div>
