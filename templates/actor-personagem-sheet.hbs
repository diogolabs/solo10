<div class="solo10-sheet-container solo10-theme-{{theme}}">
  <!-- CABEÇALHO MINIMALISTA -->
  <header class="solo10-sheet-header">
    <div class="solo10-header-left">
      <img class="solo10-profile-img" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img" title="Alterar imagem" />
    </div>

    <div class="solo10-header-main">
      <div class="solo10-title-row">
        <input type="text" class="solo10-charname" name="name" value="{{actor.name}}" placeholder="Nome da Personagem" />
        <button type="button" class="solo10-btn solo10-btn-ghost" data-action="cycleTheme" title="Alternar tema: Padrão do Sistema, Claro ou Escuro">
          <i class="fas fa-adjust"></i> {{themeLabel}}
        </button>
        <button type="button" class="solo10-btn" data-action="abrirOraculo" data-tab="cenario">
          <i class="fas fa-eye"></i> Oráculo
        </button>
        <button type="button" class="solo10-btn solo10-btn-primary" data-action="rollLivre">
          <i class="fas fa-dice-d10"></i> Testar
        </button>
      </div>

      <div class="solo10-meta-grid">
        <div class="solo10-meta-field">
          <label>Espécie / Elemento do Cenário</label>
          <input type="text" name="system.especieTipo" value="{{system.especieTipo}}" placeholder="Livre..." />
        </div>
        <div class="solo10-meta-field">
          <label>Morada Inicial</label>
          <input type="text" name="system.moradaInicial" value="{{system.moradaInicial}}" placeholder="Local..." />
        </div>
        <div class="solo10-meta-field">
          <label>Setor Atual</label>
          <input type="text" name="system.setorAtual" value="{{system.setorAtual}}" list="solo10-setores-list" placeholder="Setor..." />
          <datalist id="solo10-setores-list">
            {{#each setores}}
              <option value="{{this.nome}}"></option>
            {{/each}}
          </datalist>
        </div>
        <div class="solo10-meta-field">
          <label>Dinheiro ($)</label>
          <div class="solo10-inline-input">
            <input type="number" name="system.dinheiro" value="{{system.dinheiro}}" />
            <button type="button" class="solo10-icon-btn" data-action="calcularDinheiroInicial" title="Calcular Dinheiro Inicial (Mente x $ 1.000 = $ {{system.dinheiroInicialSugerido}})">
              <i class="fas fa-coins"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- RESERVAS: SAÚDE, POSTURA, VONTADE -->
      <div class="solo10-reservas-bar">
        <div class="solo10-reserva-box {{#if system.inconsciente}}alerta-zero{{/if}}">
          <div class="reserva-title">
            <span>Saúde</span>
            <small>5 + Corpo</small>
          </div>
          <div class="reserva-inputs">
            <input type="number" name="system.saude.value" value="{{system.saude.value}}" min="0" />
            <span class="sep">/</span>
            <span class="max">{{system.saude.max}}</span>
          </div>
          {{#if system.inconsciente}}<span class="estado-tag">Inconsciente</span>{{/if}}
        </div>

        <div class="solo10-reserva-box {{#if system.desmoralizado}}alerta-zero{{/if}}">
          <div class="reserva-title">
            <span>Postura</span>
            <small>5 + Espírito</small>
          </div>
          <div class="reserva-inputs">
            <input type="number" name="system.postura.value" value="{{system.postura.value}}" min="0" />
            <span class="sep">/</span>
            <span class="max">{{system.postura.max}}</span>
          </div>
          {{#if system.desmoralizado}}<span class="estado-tag">Desmoralizado</span>{{/if}}
        </div>

        <div class="solo10-reserva-box {{#if system.desmotivado}}alerta-zero{{/if}}">
          <div class="reserva-title">
            <span>Vontade</span>
            <small>5 + Mente</small>
          </div>
          <div class="reserva-inputs">
            <input type="number" name="system.vontade.value" value="{{system.vontade.value}}" min="0" />
            <span class="sep">/</span>
            <span class="max">{{system.vontade.max}}</span>
          </div>
          {{#if system.desmotivado}}<span class="estado-tag">Desmotivado</span>{{/if}}
        </div>

        <div class="solo10-reserva-actions">
          <button type="button" class="solo10-btn solo10-btn-xs" data-action="descansar" title="Descanso (8h): +1 Saúde, Postura e Vontade">
            Descansar (+1)
          </button>
          <button type="button" class="solo10-btn solo10-btn-xs" data-action="tratamento" title="Tratamento adequado: +2 Saúde, Postura e Vontade">
            Tratamento (+2)
          </button>
          <button type="button" class="solo10-btn solo10-btn-xs" data-action="distribuirAtributos" data-modo="resetReservas" title="Restaurar todas as reservas ao máximo">
            Máximo
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ABAS MINIMALISTAS -->
  <nav class="solo10-tabs">
    <button type="button" class="solo10-tab-btn {{#if (eq activeTab 'principal')}}active{{/if}}" data-action="changeTab" data-tab="principal">
      Atributos & Perícias
    </button>
    <button type="button" class="solo10-tab-btn {{#if (eq activeTab 'qualidades')}}active{{/if}}" data-action="changeTab" data-tab="qualidades">
      Qualidades & Armadilhas
    </button>
    <button type="button" class="solo10-tab-btn {{#if (eq activeTab 'combate')}}active{{/if}}" data-action="changeTab" data-tab="combate">
      Combate & Equipamentos
    </button>
    <button type="button" class="solo10-tab-btn {{#if (eq activeTab 'jogando')}}active{{/if}}" data-action="changeTab" data-tab="jogando">
      Cenário, Ações & Evolução
    </button>
  </nav>

  <!-- CORPO DA FICHA -->
  <section class="solo10-sheet-body">
    <!-- ABA 1: ATRIBUTOS & PERÍCIAS (ITENS MODULARES) -->
    {{#if (eq activeTab 'principal')}}
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Atributos</h3>
          <div class="solo10-header-tools">
            <span class="solo10-badge">Poder Exército: {{system.poderCombateMassa}}</span>
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="distribuirAtributos" data-modo="333">
              Equilibrar (3, 3, 3)
            </button>
          </div>
        </div>

        <div class="solo10-atributos-grid">
          <!-- CORPO -->
          <div class="solo10-atributo-card">
            <div class="attr-header">
              <h4>Corpo</h4>
              <span class="attr-total">{{system.atributos.corpo.total}}</span>
            </div>
            <p class="attr-desc">Força, agilidade e resistência física.</p>
            <div class="attr-fields">
              <div>
                <label>Valor</label>
                <input type="number" name="system.atributos.corpo.value" value="{{system.atributos.corpo.value}}" min="0" />
              </div>
              <div>
                <label>Bônus</label>
                <input type="number" name="system.atributos.corpo.bonus" value="{{system.atributos.corpo.bonus}}" />
              </div>
              <div>
                <label>+Saúde</label>
                <input type="number" name="system.saude.bonus" value="{{system.saude.bonus}}" />
              </div>
            </div>
            <button type="button" class="solo10-btn solo10-btn-primary solo10-btn-sm" data-action="rollAtributo" data-atributo="corpo">
              Rolar Corpo
            </button>
          </div>

          <!-- ESPÍRITO -->
          <div class="solo10-atributo-card">
            <div class="attr-header">
              <h4>Espírito</h4>
              <span class="attr-total">{{system.atributos.espirito.total}}</span>
            </div>
            <p class="attr-desc">Aparência, manipulação e carisma social.</p>
            <div class="attr-fields">
              <div>
                <label>Valor</label>
                <input type="number" name="system.atributos.espirito.value" value="{{system.atributos.espirito.value}}" min="0" />
              </div>
              <div>
                <label>Bônus</label>
                <input type="number" name="system.atributos.espirito.bonus" value="{{system.atributos.espirito.bonus}}" />
              </div>
              <div>
                <label>+Postura</label>
                <input type="number" name="system.postura.bonus" value="{{system.postura.bonus}}" />
              </div>
            </div>
            <button type="button" class="solo10-btn solo10-btn-primary solo10-btn-sm" data-action="rollAtributo" data-atributo="espirito">
              Rolar Espírito
            </button>
          </div>

          <!-- MENTE -->
          <div class="solo10-atributo-card">
            <div class="attr-header">
              <h4>Mente</h4>
              <span class="attr-total">{{system.atributos.mente.total}}</span>
            </div>
            <p class="attr-desc">Inteligência, raciocínio e determinação.</p>
            <div class="attr-fields">
              <div>
                <label>Valor</label>
                <input type="number" name="system.atributos.mente.value" value="{{system.atributos.mente.value}}" min="0" />
              </div>
              <div>
                <label>Bônus</label>
                <input type="number" name="system.atributos.mente.bonus" value="{{system.atributos.mente.bonus}}" />
              </div>
              <div>
                <label>+Vontade</label>
                <input type="number" name="system.vontade.bonus" value="{{system.vontade.bonus}}" />
              </div>
            </div>
            <button type="button" class="solo10-btn solo10-btn-primary solo10-btn-sm" data-action="rollAtributo" data-atributo="mente">
              Rolar Mente
            </button>
          </div>
        </div>
      </div>

      <!-- PERÍCIAS (ITENS MODULARES INDEPENDENTES DE ATRIBUTO) -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <div>
            <h3>Perícias ({{pericias.length}})</h3>
            <small class="solo10-muted">Livres de Atributo: cada Perícia concede +2 ao Atributo escolhido na hora do teste.</small>
          </div>
          <div class="solo10-header-tools">
            <button type="button" class="solo10-btn solo10-btn-sm" data-action="abrirCompendio" data-pack="pericias" title="Abrir Compêndio de Perícias para arrastar para a ficha">
              <i class="fas fa-book-open"></i> Compêndio
            </button>
            <button type="button" class="solo10-btn solo10-btn-sm solo10-btn-primary" data-action="createItem" data-type="pericia">
              <i class="fas fa-plus"></i> Nova Perícia
            </button>
          </div>
        </div>

        <div class="solo10-item-list">
          {{#each pericias}}
            <div class="solo10-item-row">
              <div class="item-main">
                <span class="item-title">{{this.name}}</span>
                <span class="solo10-mini-tag">+2</span>
                {{#if this.system.descricao}}
                  <p class="item-sub">{{{this.system.descricao}}}</p>
                {{/if}}
              </div>
              <div class="item-controls">
                <button type="button" class="solo10-btn solo10-btn-xs solo10-btn-primary" data-action="rollPericia" data-item-id="{{this.id}}" title="Rolar teste com {{this.name}} (+2)">
                  <i class="fas fa-dice-d10"></i> Rolar
                </button>
                <button type="button" class="solo10-icon-btn" data-action="postItem" data-item-id="{{this.id}}" title="Enviar ao Chat"><i class="fas fa-comment"></i></button>
                <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}" title="Editar Perícia"><i class="fas fa-edit"></i></button>
                <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}" title="Remover"><i class="fas fa-trash"></i></button>
              </div>
            </div>
          {{else}}
            <div class="solo10-empty">
              Nenhuma Perícia na ficha. Arraste Perícias do <strong>Compêndio</strong> ou clique em <strong>+ Nova Perícia</strong> (Iniciais recomendadas: {{maxPericiasIniciais}}).
            </div>
          {{/each}}
        </div>

        <div class="solo10-grid-2" style="margin-top: 10px;">
          <div class="solo10-form-group">
            <label>Idiomas Conhecidos</label>
            <input type="text" name="system.idiomasLista" value="{{system.idiomasLista}}" placeholder="Idiomas que domina..." />
          </div>
          <div class="solo10-form-group">
            <label>Bônus de Poder Mental Acumulado (Para teste futuro)</label>
            <input type="number" name="system.bonusMentalFuturo" value="{{system.bonusMentalFuturo}}" />
          </div>
        </div>
      </div>
    {{/if}}

    <!-- ABA 2: QUALIDADES (ITENS MODULARES) & ARMADILHAS -->
    {{#if (eq activeTab 'qualidades')}}
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <div>
            <h3>Qualidades ({{qualidades.length}})</h3>
            <small class="solo10-muted">Arraste do Compêndio de Qualidades ou crie novas Qualidades para o seu cenário.</small>
          </div>
          <div class="solo10-header-tools">
            <button type="button" class="solo10-btn solo10-btn-sm" data-action="abrirCompendio" data-pack="qualidades" title="Abrir Compêndio de Qualidades">
              <i class="fas fa-book-open"></i> Compêndio
            </button>
            <button type="button" class="solo10-btn solo10-btn-sm solo10-btn-primary" data-action="createItem" data-type="qualidade">
              <i class="fas fa-plus"></i> Nova Qualidade
            </button>
          </div>
        </div>

        <div class="solo10-item-list">
          {{#each qualidades}}
            <div class="solo10-item-row">
              <div class="item-main">
                <div class="item-title-line">
                  <span class="item-title">{{this.name}}</span>
                  <span class="solo10-mini-tag">{{#if (eq this.system.tipo 'ativa')}}Ativa{{else}}Passiva{{/if}}</span>
                  {{#if this.system.bonusSaude}}<span class="solo10-mini-tag">+{{this.system.bonusSaude}} Saúde</span>{{/if}}
                  {{#if this.system.bonusPostura}}<span class="solo10-mini-tag">+{{this.system.bonusPostura}} Postura</span>{{/if}}
                  {{#if this.system.bonusVontade}}<span class="solo10-mini-tag">+{{this.system.bonusVontade}} Vontade</span>{{/if}}
                  {{#if this.system.bonusRD}}<span class="solo10-mini-tag">+{{this.system.bonusRD}} RD</span>{{/if}}
                  {{#if this.system.bonusTeste}}<span class="solo10-mini-tag">+{{this.system.bonusTeste}} Teste</span>{{/if}}
                  {{#if this.system.concedeVantagem}}<span class="solo10-mini-tag">Vantagem</span>{{/if}}
                </div>
                {{#if this.system.descricao}}
                  <p class="item-sub">{{{this.system.descricao}}}</p>
                {{/if}}
              </div>
              <div class="item-controls">
                {{#if (eq this.system.tipo 'ativa')}}
                  <button type="button" class="solo10-btn solo10-btn-xs solo10-btn-primary" data-action="usarQualidadeAtiva" data-item-id="{{this.id}}">
                    <i class="fas fa-dice-d10"></i> Testar
                  </button>
                {{/if}}
                <button type="button" class="solo10-icon-btn" data-action="postItem" data-item-id="{{this.id}}" title="Enviar ao Chat"><i class="fas fa-comment"></i></button>
                <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}" title="Editar"><i class="fas fa-edit"></i></button>
                <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}" title="Remover"><i class="fas fa-trash"></i></button>
              </div>
            </div>
          {{else}}
            <div class="solo10-empty">
              Nenhuma Qualidade na ficha. Arraste Qualidades do <strong>Compêndio</strong> ou clique em <strong>+ Nova Qualidade</strong> (Iniciais recomendadas: 3).
            </div>
          {{/each}}
        </div>
      </div>

      <!-- ARMADILHAS -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Armadilhas (Qualidade Armadilheiro)</h3>
        </div>
        <div class="solo10-trap-builder">
          <div class="solo10-grid-2">
            <select data-field="efeitoNovaArmadilha">
              {{#each efeitosArmadilha}}
                <option value="{{@key}}">{{this.label}} — {{this.descricao}}</option>
              {{/each}}
            </select>
            <button type="button" class="solo10-btn solo10-btn-sm solo10-btn-primary" data-action="montarArmadilha">
              <i class="fas fa-dice-d10"></i> Montar Armadilha — Mente (Sobrevivência)
            </button>
          </div>
          <label class="solo10-checkbox">
            <input type="checkbox" data-field="perigoSecArmadilha" />
            <span>Incluir Perigo Secundário para encontrar/desarmar (10 + Bônus de Poder, máx 15)</span>
          </label>
        </div>

        {{#if armadilhas.length}}
          <div class="solo10-item-list" style="margin-top: 8px;">
            {{#each armadilhas}}
              <div class="solo10-item-row">
                <div class="item-main">
                  <span class="item-title">{{this.name}}</span>
                  <span class="solo10-mini-tag">Bônus de Poder +{{this.system.bonusPoder}}</span>
                  <p class="item-sub">{{{this.system.descricao}}}</p>
                </div>
                <div class="item-controls">
                  <button type="button" class="solo10-icon-btn" data-action="postItem" data-item-id="{{this.id}}"><i class="fas fa-comment"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}"><i class="fas fa-trash"></i></button>
                </div>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
    {{/if}}

    <!-- ABA 3: COMBATE & EQUIPAMENTOS -->
    {{#if (eq activeTab 'combate')}}
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Combate, Reação e Fuga</h3>
          <span class="solo10-badge">Resistência a Dano Total (RD): {{system.resistenciaDanoTotal}}</span>
        </div>
        <div class="solo10-combat-quickbar">
          <button type="button" class="solo10-btn solo10-btn-primary" data-action="atacarArma" data-alcance="corporal">
            Ataque Corporal
          </button>
          <button type="button" class="solo10-btn solo10-btn-primary" data-action="atacarArma" data-alcance="distancia">
            Ataque a Distância
          </button>
          <button type="button" class="solo10-btn" data-action="defenderFisico" data-pericia="Combate Corporal">
            Defender (Corporal)
          </button>
          <button type="button" class="solo10-btn" data-action="defenderFisico" data-pericia="Combate a Distância">
            Defender (Distância)
          </button>
          <button type="button" class="solo10-btn" data-action="fugirCombate">
            Fugir (Atletismo)
          </button>
        </div>
      </div>

      <!-- ARMAS -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Armas</h3>
          <div class="solo10-header-tools">
            <button type="button" class="solo10-btn solo10-btn-sm" data-action="abrirCompendio" data-pack="equipamentos">
              <i class="fas fa-book-open"></i> Compêndio
            </button>
            <button type="button" class="solo10-btn solo10-btn-sm solo10-btn-primary" data-action="createItem" data-type="arma">
              <i class="fas fa-plus"></i> Nova Arma
            </button>
          </div>
        </div>

        <table class="solo10-table">
          <thead>
            <tr>
              <th>Arma</th>
              <th>Alcance</th>
              <th>Dano</th>
              <th>Propriedades</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each armas}}
              <tr>
                <td><strong>{{this.name}}</strong></td>
                <td>{{#if (eq this.system.alcance 'distancia')}}Distância{{else}}Corporal{{/if}}</td>
                <td>
                  {{#if (eq this.system.tipoDano 'fixo')}}
                    {{this.system.danoFixo}}
                  {{else}}
                    Corpo + {{this.system.bonusDano}} ({{add ../system.atributos.corpo.total this.system.bonusDano}})
                  {{/if}}
                </td>
                <td>
                  {{#if this.system.leve}}<span class="solo10-mini-tag">Leve</span>{{/if}}
                  {{#if this.system.pesada}}<span class="solo10-mini-tag">Pesada</span>{{/if}}
                  {{#if this.system.duasMaos}}<span class="solo10-mini-tag">2 Mãos</span>{{/if}}
                </td>
                <td class="solo10-table-actions">
                  <button type="button" class="solo10-btn solo10-btn-xs solo10-btn-primary" data-action="atacarArma" data-item-id="{{this.id}}">
                    Atacar
                  </button>
                  <button type="button" class="solo10-icon-btn" data-action="postItem" data-item-id="{{this.id}}"><i class="fas fa-comment"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}"><i class="fas fa-edit"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}"><i class="fas fa-trash"></i></button>
                </td>
              </tr>
            {{else}}
              <tr><td colspan="5" class="solo10-empty">Nenhuma arma. Arraste do Compêndio ou crie uma nova.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <!-- ARMADURAS E ESCUDOS -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Armaduras & Escudos</h3>
          <div class="solo10-header-tools">
            <button type="button" class="solo10-btn solo10-btn-sm" data-action="abrirCompendio" data-pack="equipamentos">
              <i class="fas fa-book-open"></i> Compêndio
            </button>
            <button type="button" class="solo10-btn solo10-btn-sm solo10-btn-primary" data-action="createItem" data-type="armadura">
              <i class="fas fa-plus"></i> Nova Armadura
            </button>
          </div>
        </div>

        <table class="solo10-table">
          <thead>
            <tr>
              <th>Uso</th>
              <th>Armadura / Escudo</th>
              <th>RD</th>
              <th>Propriedades</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each armaduras}}
              <tr>
                <td>
                  <input type="checkbox" {{#if this.system.equipada}}checked{{/if}} data-action="toggleEquipItem" data-item-id="{{this.id}}" />
                </td>
                <td><strong>{{this.name}}</strong></td>
                <td>-{{this.system.resistenciaDano}}</td>
                <td>
                  {{#if this.system.penalidadeAgilidade}}<span class="solo10-mini-tag warn">*Desvantagem Agilidade</span>{{/if}}
                  {{#if this.system.leve}}<span class="solo10-mini-tag">Leve</span>{{/if}}
                  {{#if this.system.escudo}}<span class="solo10-mini-tag">Escudo</span>{{/if}}
                </td>
                <td class="solo10-table-actions">
                  <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}"><i class="fas fa-edit"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}"><i class="fas fa-trash"></i></button>
                </td>
              </tr>
            {{else}}
              <tr><td colspan="5" class="solo10-empty">Nenhuma armadura adicionada.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <!-- DANOS DIVERSOS & OFÍCIOS -->
      <div class="solo10-grid-2">
        <div class="solo10-panel">
          <h3>Danos Diversos</h3>
          <div class="solo10-diverse-row">
            <span>Queda (Altura - 3):</span>
            <input type="number" data-field="alturaQueda" value="5" min="0" style="width:55px;" />
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="aplicarDanoDiverso" data-fonte="queda">Aplicar</button>
          </div>
          <div class="solo10-diverse-row">
            <span>Fogo / Ácido (3 a 10):</span>
            <input type="number" data-field="danoFogoAcido" value="3" min="3" max="10" style="width:55px;" />
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="aplicarDanoDiverso" data-fonte="fogo">Aplicar</button>
          </div>
          <div class="solo10-diverse-row">
            <span>Veneno (2 a 8):</span>
            <input type="number" data-field="danoVeneno" value="2" min="2" max="8" style="width:55px;" />
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="aplicarDanoDiverso" data-fonte="veneno">Aplicar</button>
          </div>
        </div>

        <div class="solo10-panel">
          <h3>Ofícios (Criar / Melhorar Itens)</h3>
          <div class="solo10-form-group">
            <label>Custo ($ 100 = 1 dia de trabalho)</label>
            <input type="number" data-field="custoOficio" value="100" min="100" step="100" />
          </div>
          <div class="solo10-grid-2" style="margin-top: 6px;">
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="testarOficio" data-tipo="oficios">
              Itens/Fort. (Ofícios)
            </button>
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="testarOficio" data-tipo="veiculos">
              Veículos (Condução)
            </button>
          </div>
        </div>
      </div>

      <!-- PERTENCES -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Equipamentos & Pertences</h3>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="createItem" data-type="equipamento">
            <i class="fas fa-plus"></i> Novo Item
          </button>
        </div>
        <table class="solo10-table">
          <thead>
            <tr>
              <th>Item</th>
              <th>Qtd</th>
              <th>Custo ($)</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each equipamentos}}
              <tr>
                <td><strong>{{this.name}}</strong></td>
                <td>{{this.system.quantidade}}</td>
                <td>$ {{this.system.custo}}</td>
                <td class="solo10-table-actions">
                  <button type="button" class="solo10-icon-btn" data-action="postItem" data-item-id="{{this.id}}"><i class="fas fa-comment"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}"><i class="fas fa-edit"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}"><i class="fas fa-trash"></i></button>
                </td>
              </tr>
            {{else}}
              <tr><td colspan="4" class="solo10-empty">Nenhum equipamento registrado.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{/if}}

    <!-- ABA 4: CENÁRIO, AÇÕES DE SETOR, EVOLUÇÃO & METAS -->
    {{#if (eq activeTab 'jogando')}}
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Ações no Setor ({{system.setorAtual}})</h3>
          <label class="solo10-checkbox">
            <input type="checkbox" name="system.investigadoCrime" {{#if system.investigadoCrime}}checked{{/if}} />
            <span>Investigado por Crime</span>
          </label>
        </div>

        <div class="solo10-actions-grid">
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="abrigo">
            Abrigo / Comida (Investigação)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="comprar">
            Comprar / Barganhar (Manipulação)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="encontrarPessoa">
            Encontrar Pessoa (Investigação)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="interagirPersonagem">
            Interagir com Personagem (Oráculo)
          </button>
        </div>

        <h4 class="solo10-subhead">Conseguir Dinheiro (Por Hora)</h4>
        <div class="solo10-actions-grid">
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="trabalharHonesto">
            Trabalho Honesto (+$ 25/h)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="roubarEspancar">
            Roubar/Espancar ($ 20 + 1D10/h)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="convencerLudibriar">
            Ludibriar ($ 20 + 1D10/h)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="baterCarteiras">
            Bater Carteiras ($ 30 + 1D10/h)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="acaoSetor" data-acao="informatica">
            Informática ($ 30 + 1D10/h)
          </button>
        </div>
      </div>

      <!-- EVOLUÇÃO (XP) -->
      <div class="solo10-panel">
        <div class="solo10-panel-header">
          <h3>Evolução (Experiência)</h3>
          <div class="solo10-header-tools">
            <span>Dias: <input type="number" name="system.diasVividos" value="{{system.diasVividos}}" style="width:48px;" /></span>
            <span>XP Disp.: <input type="number" name="system.experiencia.value" value="{{system.experiencia.value}}" style="width:48px;" /></span>
            <span>XP Total: <input type="number" name="system.experiencia.total" value="{{system.experiencia.total}}" style="width:48px;" /></span>
          </div>
        </div>
        <div class="solo10-grid-2" style="margin-bottom: 8px;">
          <button type="button" class="solo10-btn solo10-btn-xs" data-action="addDiaVivido">
            +1 Dia Vivido (+1 XP)
          </button>
          <button type="button" class="solo10-btn solo10-btn-xs" data-action="addAreaVencida">
            +1 Área Vencida em Acontecimento Importante (+1 XP)
          </button>
        </div>
        <div class="solo10-atributos-grid">
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="gastarXp" data-tipo="atributo">
            +1 Atributo (20 XP)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="gastarXp" data-tipo="pericia">
            Nova Perícia (15 XP)
          </button>
          <button type="button" class="solo10-btn solo10-btn-sm" data-action="gastarXp" data-tipo="qualidade">
            Nova Qualidade (20 XP)
          </button>
        </div>
      </div>

      <!-- METAS, ACONTECIMENTO & CAMPANHA -->
      <div class="solo10-grid-2">
        <div class="solo10-panel">
          <div class="solo10-panel-header">
            <h3>Metas Pessoais</h3>
            <button type="button" class="solo10-btn solo10-btn-xs" data-action="createItem" data-type="meta">
              + Meta
            </button>
          </div>
          <ul class="solo10-metas-list">
            {{#each metas}}
              <li class="solo10-meta-item {{#if this.system.concluida}}concluida{{/if}}">
                <input type="checkbox" {{#if this.system.concluida}}checked{{/if}} data-action="toggleMetaConcluida" data-item-id="{{this.id}}" />
                <span class="meta-name">{{this.name}}</span>
                <div class="meta-btns">
                  <button type="button" class="solo10-icon-btn" data-action="editItem" data-item-id="{{this.id}}"><i class="fas fa-edit"></i></button>
                  <button type="button" class="solo10-icon-btn" data-action="deleteItem" data-item-id="{{this.id}}"><i class="fas fa-trash"></i></button>
                </div>
              </li>
            {{else}}
              <li class="solo10-empty">Nenhuma meta cadastrada.</li>
            {{/each}}
          </ul>
        </div>

        <div class="solo10-panel">
          <h3>Acontecimento & Campanha</h3>
          <div class="solo10-form-group">
            <label>Acontecimento Importante (Locais 0 a 5)</label>
            <div class="solo10-inline-input">
              <input type="text" name="system.acontecimento.titulo" value="{{system.acontecimento.titulo}}" placeholder="Enredo..." style="flex:1;" />
              <input type="number" name="system.acontecimento.locaisVisitados" value="{{system.acontecimento.locaisVisitados}}" min="0" max="5" style="width:50px;" title="Locais visitados (1 a 5)" />
            </div>
          </div>
          <div class="solo10-form-group">
            <label>Campanha (Ideia Central & Falhas)</label>
            <div class="solo10-inline-input">
              <input type="text" name="system.campanha.ideiaCentral" value="{{system.campanha.ideiaCentral}}" placeholder="Ideia central..." style="flex:1;" />
              <input type="number" name="system.campanha.falhas" value="{{system.campanha.falhas}}" min="0" style="width:50px;" title="Falhas acumuladas" />
            </div>
          </div>
        </div>
      </div>

      <div class="solo10-panel">
        <h3>Notas & Diário</h3>
        <textarea name="system.notas" rows="4" placeholder="Anotações de jogo...">{{system.notas}}</textarea>
      </div>
    {{/if}}
  </section>
</div>
